        "acp/transcript": "pass",
        "setup/binary": "pass",
        "setup/env.OPENAI_API_KEY": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../AGENTS.md": "pass",
        "setup/instructions.written.~/.codex/AGENTS.md": "pass",
        "setup/skills": "pass"
