        "acp/inflight.resume": "pass:by-id",
        "acp/inflight.resume-twice": "pass:by-id",
        "acp/instructions../AGENTS.md": "pass",
        "acp/instructions.~/.codex/AGENTS.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/resume.context": "pass",
        "acp/resume.load": "pass:by-id",
        "acp/resume.replay": "skip:by-id",
