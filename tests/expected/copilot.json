{
  "harness": "copilot",
  "runs": [
    {
      "name": "probes",
      "mode": "acp",
      "probes": "resume,inflight,compact,transcript,seed,seedkinds=shapes,tools,deferred",
      "note": "No inflight=cancel or inflight=hold runs: this agent runs the gated tool without asking its client (acp/inflight.park = skip:not-gated), so there is no approval for the answer to reach and those runs repeat this one. If inflight.park changes here, add them back.",
      "checks": {
        "acp/compact": "skip:no-command",
        "acp/deferred.armed": "pass:no-search-tool",
        "acp/hook-injection": "pass",
        "acp/hook.prompt": "pass",
        "acp/hook.stop": "pass",
        "acp/inflight.park": "skip:not-gated",
        "acp/instructions../.github/instructions/belt.instructions.md": "pass",
        "acp/instructions.~/.copilot/instructions/belt.instructions.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/resume.context": "pass",
        "acp/resume.load": "pass",
        "acp/resume.replay": "pass",
        "acp/seed.appended": "pass",
        "acp/seed.hand-built": "pass",
        "acp/seedkinds.assistant-text": "pass",
        "acp/seedkinds.compaction.context": "finding:retired-kept",
        "acp/seedkinds.compaction.history": "pass",
        "acp/seedkinds.compaction.request": "finding:retired-sent",
        "acp/seedkinds.file-uri": "pass:as-image",
        "acp/seedkinds.first-user-message": "pass",
        "acp/seedkinds.foreign.claude-edit": "pass:as-tool",
        "acp/seedkinds.foreign.claude-read": "pass:as-tool",
        "acp/seedkinds.foreign.codex-apply_patch": "pass:as-tool",
        "acp/seedkinds.foreign.codex-exec_command": "pass:as-tool",
        "acp/seedkinds.foreign.gemini-write_file": "pass:as-tool",
        "acp/seedkinds.foreign.nested-arguments": "pass:as-tool",
        "acp/seedkinds.image-only-result": "finding:image-dropped",
        "acp/seedkinds.in-message-result": "finding:image-dropped",
        "acp/seedkinds.parallel-same-id": "pass:as-tool",
        "acp/seedkinds.reasoning": "finding:not-kept",
        "acp/seedkinds.retired-answer-as-summary.context": "finding:retired-kept",
        "acp/seedkinds.retired-answer-as-summary.history": "pass",
        "acp/seedkinds.retired-answer-as-summary.request": "finding:retired-sent",
        "acp/seedkinds.retired-tool.context": "finding:retired-kept-user",
        "acp/seedkinds.retired-tool.history": "pass",
        "acp/seedkinds.retired-tool.request": "finding:retired-sent-user",
        "acp/seedkinds.second-turn-s-answer": "pass",
        "acp/seedkinds.second-turn-s-user-message": "pass",
        "acp/seedkinds.shown-only": "pass",
        "acp/seedkinds.tool-after-text": "pass",
        "acp/seedkinds.tool-call-arguments": "pass",
        "acp/seedkinds.tool-image": "finding:not-given",
        "acp/seedkinds.tool-result": "pass",
        "acp/seedkinds.trailing-prompt.history": "pass",
        "acp/seedkinds.trailing-prompt.request": "pass:sent",
        "acp/seedkinds.trailing-tool-result.history": "pass",
        "acp/seedkinds.trailing-tool-result.request": "pass:sent",
        "acp/seedkinds.untyped-file-path": "pass:as-text",
        "acp/seedkinds.user-attachments.image": "pass:as-image",
        "acp/seedkinds.user-attachments.pdf": "pass:as-reference",
        "acp/session.answer": "pass",
        "acp/session.completed": "pass",
        "acp/session.start": "pass",
        "acp/streaming": "pass",
        "acp/transcript": "pass",
        "setup/binary": "pass",
        "setup/env.COPILOT_ALLOW_ALL": "pass",
        "setup/env.COPILOT_MODEL": "pass",
        "setup/env.COPILOT_PROVIDER_API_KEY": "pass",
        "setup/env.COPILOT_PROVIDER_BASE_URL": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../.github/instructions/belt.instructions.md": "pass",
        "setup/instructions.written.~/.copilot/instructions/belt.instructions.md": "pass",
        "setup/skills": "pass"
      }
    },
    {
      "name": "resume-kill",
      "mode": "acp",
      "probes": "resume=kill",
      "checks": {
        "acp/hook-injection": "pass",
        "acp/hook.prompt": "pass",
        "acp/hook.stop": "pass",
        "acp/instructions../.github/instructions/belt.instructions.md": "pass",
        "acp/instructions.~/.copilot/instructions/belt.instructions.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/resume.context": "pass",
        "acp/resume.load": "pass",
        "acp/resume.replay": "pass",
        "acp/session.answer": "pass",
        "acp/session.completed": "pass",
        "acp/session.start": "pass",
        "acp/streaming": "pass",
        "setup/binary": "pass",
        "setup/env.COPILOT_ALLOW_ALL": "pass",
        "setup/env.COPILOT_MODEL": "pass",
        "setup/env.COPILOT_PROVIDER_API_KEY": "pass",
        "setup/env.COPILOT_PROVIDER_BASE_URL": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../.github/instructions/belt.instructions.md": "pass",
        "setup/instructions.written.~/.copilot/instructions/belt.instructions.md": "pass",
        "setup/skills": "pass"
      }
    }
  ]
}
