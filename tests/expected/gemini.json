{
  "harness": "gemini",
  "runs": [
    {
      "name": "probes",
      "mode": "acp",
      "probes": "resumeafter=65s,resume,inflight,compact,transcript,seed,seedkinds=shapes,tools,deferred",
      "note": "resumeafter=65s on every run: gemini 0.61 clobbers a session loaded in the UTC minute it was created (README, Resuming a session), so every load of a session gemini wrote is held back 65s; without it resume.load, inflight.resume and seed.appended depended on the clock.",
      "checks": {
        "acp/compact.run": "finding:as-prompt",
        "acp/deferred.armed": "pass:no-search-tool",
        "acp/hook-injection": "pass",
        "acp/hook.post-tool": "skip:known-missing",
        "acp/hook.pre-compact": "pass",
        "acp/hook.pre-tool": "skip:known-missing",
        "acp/hook.prompt": "pass",
        "acp/hook.session-start": "skip:known-missing",
        "acp/hook.stop": "pass",
        "acp/inflight.park": "pass",
        "acp/inflight.reraise": "finding:none",
        "acp/inflight.resume": "pass",
        "acp/inflight.resume-twice": "skip:refused",
        "acp/instructions../GEMINI.md": "pass",
        "acp/instructions.~/.gemini/GEMINI.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/resume.context": "pass",
        "acp/resume.load": "pass",
        "acp/resume.replay": "pass",
        "acp/seed.appended": "pass",
        "acp/seed.hand-built": "pass",
        "acp/seedkinds.assistant-text": "pass",
        "acp/seedkinds.compaction.context": "pass",
        "acp/seedkinds.compaction.history": "finding:summary-only",
        "acp/seedkinds.compaction.request": "pass",
        "acp/seedkinds.file-uri": "pass:as-image",
        "acp/seedkinds.first-user-message": "pass",
        "acp/seedkinds.foreign.claude-edit": "pass:as-tool",
        "acp/seedkinds.foreign.claude-read": "pass:as-tool",
        "acp/seedkinds.foreign.codex-apply_patch": "pass:as-tool",
        "acp/seedkinds.foreign.codex-exec_command": "pass:as-tool",
        "acp/seedkinds.foreign.gemini-write_file": "pass:as-tool",
        "acp/seedkinds.foreign.nested-arguments": "pass:as-tool",
        "acp/seedkinds.image-only-result": "pass:as-image",
        "acp/seedkinds.in-message-result": "pass:as-image",
        "acp/seedkinds.parallel-same-id": "pass:as-tool",
        "acp/seedkinds.reasoning": "finding:not-kept",
        "acp/seedkinds.retired-answer-as-summary.context": "pass",
        "acp/seedkinds.retired-answer-as-summary.history": "finding:dropped-user",
        "acp/seedkinds.retired-answer-as-summary.request": "pass",
        "acp/seedkinds.retired-tool.context": "pass",
        "acp/seedkinds.retired-tool.history": "finding:summary-only",
        "acp/seedkinds.retired-tool.request": "pass",
        "acp/seedkinds.second-turn-s-answer": "pass",
        "acp/seedkinds.second-turn-s-user-message": "pass",
        "acp/seedkinds.shown-only": "pass",
        "acp/seedkinds.tool-after-text": "pass",
        "acp/seedkinds.tool-call-arguments": "pass",
        "acp/seedkinds.tool-image": "pass:as-image",
        "acp/seedkinds.tool-result": "pass",
        "acp/seedkinds.trailing-prompt.history": "pass",
        "acp/seedkinds.trailing-prompt.request": "pass:sent",
        "acp/seedkinds.trailing-tool-result.history": "pass",
        "acp/seedkinds.trailing-tool-result.request": "pass:sent",
        "acp/seedkinds.untyped-file-path": "pass:as-text",
        "acp/seedkinds.user-attachments.image": "pass:as-image",
        "acp/seedkinds.user-attachments.pdf": "pass:as-document",
        "acp/session.answer": "pass",
        "acp/session.completed": "pass",
        "acp/session.start": "pass",
        "acp/streaming": "pass",
        "acp/transcript": "pass",
        "setup/binary": "pass",
        "setup/env.GEMINI_API_KEY": "pass",
        "setup/env.GEMINI_CLI_TRUST_WORKSPACE": "pass",
        "setup/env.GOOGLE_GEMINI_BASE_URL": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../GEMINI.md": "pass",
        "setup/instructions.written.~/.gemini/GEMINI.md": "pass",
        "setup/skills": "pass"
      }
    },
    {
      "name": "resume-kill",
      "mode": "acp",
      "probes": "resumeafter=65s,resume=kill",
      "checks": {
        "acp/hook-injection": "pass",
        "acp/hook.post-tool": "skip:known-missing",
        "acp/hook.pre-compact": "pass",
        "acp/hook.pre-tool": "skip:known-missing",
        "acp/hook.prompt": "pass",
        "acp/hook.session-start": "skip:known-missing",
        "acp/hook.stop": "pass",
        "acp/instructions../GEMINI.md": "pass",
        "acp/instructions.~/.gemini/GEMINI.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/resume.context": "pass",
        "acp/resume.load": "pass",
        "acp/resume.replay": "pass",
        "acp/session.answer": "pass",
        "acp/session.completed": "pass",
        "acp/session.start": "pass",
        "acp/streaming": "pass",
        "setup/binary": "pass",
        "setup/env.GEMINI_API_KEY": "pass",
        "setup/env.GEMINI_CLI_TRUST_WORKSPACE": "pass",
        "setup/env.GOOGLE_GEMINI_BASE_URL": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../GEMINI.md": "pass",
        "setup/instructions.written.~/.gemini/GEMINI.md": "pass",
        "setup/skills": "pass"
      }
    },
    {
      "name": "inflight-cancel",
      "mode": "acp",
      "probes": "resumeafter=65s,inflight=cancel",
      "checks": {
        "acp/hook-injection": "pass",
        "acp/hook.post-tool": "skip:known-missing",
        "acp/hook.pre-compact": "pass",
        "acp/hook.pre-tool": "skip:known-missing",
        "acp/hook.prompt": "pass",
        "acp/hook.session-start": "skip:known-missing",
        "acp/hook.stop": "pass",
        "acp/inflight.park": "pass",
        "acp/inflight.reraise": "finding:none",
        "acp/inflight.resume": "pass",
        "acp/inflight.resume-twice": "skip:refused",
        "acp/instructions../GEMINI.md": "pass",
        "acp/instructions.~/.gemini/GEMINI.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/session.answer": "pass",
        "acp/session.completed": "pass",
        "acp/session.start": "pass",
        "acp/streaming": "pass",
        "setup/binary": "pass",
        "setup/env.GEMINI_API_KEY": "pass",
        "setup/env.GEMINI_CLI_TRUST_WORKSPACE": "pass",
        "setup/env.GOOGLE_GEMINI_BASE_URL": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../GEMINI.md": "pass",
        "setup/instructions.written.~/.gemini/GEMINI.md": "pass",
        "setup/skills": "pass"
      }
    },
    {
      "name": "inflight-hold",
      "mode": "acp",
      "probes": "resumeafter=65s,inflight=hold",
      "checks": {
        "acp/hook-injection": "pass",
        "acp/hook.post-tool": "skip:known-missing",
        "acp/hook.pre-compact": "pass",
        "acp/hook.pre-tool": "skip:known-missing",
        "acp/hook.prompt": "pass",
        "acp/hook.session-start": "skip:known-missing",
        "acp/hook.stop": "pass",
        "acp/inflight.park": "pass",
        "acp/inflight.reraise": "finding:none",
        "acp/inflight.resume": "pass",
        "acp/inflight.resume-twice": "skip:refused",
        "acp/instructions../GEMINI.md": "pass",
        "acp/instructions.~/.gemini/GEMINI.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/session.answer": "pass",
        "acp/session.completed": "pass",
        "acp/session.start": "pass",
        "acp/streaming": "pass",
        "setup/binary": "pass",
        "setup/env.GEMINI_API_KEY": "pass",
        "setup/env.GEMINI_CLI_TRUST_WORKSPACE": "pass",
        "setup/env.GOOGLE_GEMINI_BASE_URL": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../GEMINI.md": "pass",
        "setup/instructions.written.~/.gemini/GEMINI.md": "pass",
        "setup/skills": "pass"
      }
    }
  ]
}
