{
  "harness": "grok",
  "runs": [
    {
      "name": "probes",
      "mode": "acp",
      "probes": "resume,inflight,compact,transcript,seed,seedkinds,tools,deferred",
      "checks": {
        "acp/compact.context": "pass:summary",
        "acp/compact.run": "pass",
        "acp/deferred.armed": "pass",
        "acp/deferred.expanded": "pass:nothing-new",
        "acp/hook-injection": "skip:no-channel",
        "acp/hook.post-tool": "pass",
        "acp/hook.pre-tool": "pass",
        "acp/hook.prompt": "pass",
        "acp/hook.stop": "pass",
        "acp/inflight.park": "skip:not-gated",
        "acp/instructions../AGENTS.md": "pass",
        "acp/instructions.~/.grok/AGENTS.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/resume.context": "pass",
        "acp/resume.load": "pass",
        "acp/resume.replay": "pass",
        "acp/seed.appended": "pass",
        "acp/seed.hand-built": "pass",
        "acp/seedkinds.assistant-text": "pass",
        "acp/seedkinds.first-user-message": "pass",
        "acp/seedkinds.reasoning": "pass",
        "acp/seedkinds.second-turn-s-answer": "pass",
        "acp/seedkinds.second-turn-s-user-message": "pass",
        "acp/seedkinds.tool-call-arguments": "pass",
        "acp/seedkinds.tool-result": "pass",
        "acp/session.answer": "pass",
        "acp/session.completed": "pass",
        "acp/session.start": "pass",
        "acp/streaming": "pass",
        "acp/transcript": "pass",
        "setup/binary": "pass",
        "setup/env.GROK_CLI_CHAT_PROXY_BASE_URL": "pass",
        "setup/env.GROK_CONVERSATIONS_BASE_URL": "pass",
        "setup/env.GROK_FEEDBACK_BASE_URL": "pass",
        "setup/env.GROK_MANAGED_CONFIG_URL": "pass",
        "setup/env.GROK_MODELS_BASE_URL": "pass",
        "setup/env.GROK_TRACE_UPLOAD_URL": "pass",
        "setup/env.GROK_XAI_API_BASE_URL": "pass",
        "setup/env.XAI_API_KEY": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../AGENTS.md": "pass",
        "setup/instructions.written.~/.grok/AGENTS.md": "pass",
        "setup/skills": "pass"
      },
      "note": "No inflight=cancel or inflight=hold runs: this agent runs the gated tool without asking its client (acp/inflight.park = skip:not-gated), so there is no approval for the answer to reach and those runs repeat this one. If inflight.park changes here, add them back."
    },
    {
      "name": "resume-kill",
      "mode": "acp",
      "probes": "resume=kill",
      "checks": {
        "acp/hook-injection": "skip:no-channel",
        "acp/hook.post-tool": "pass",
        "acp/hook.pre-tool": "pass",
        "acp/hook.prompt": "pass",
        "acp/hook.stop": "pass",
        "acp/instructions../AGENTS.md": "pass",
        "acp/instructions.~/.grok/AGENTS.md": "pass",
        "acp/model": "pass",
        "acp/requests": "pass",
        "acp/resume.context": "pass",
        "acp/resume.load": "pass",
        "acp/resume.replay": "pass",
        "acp/session.answer": "pass",
        "acp/session.completed": "pass",
        "acp/session.start": "pass",
        "acp/streaming": "pass",
        "setup/binary": "pass",
        "setup/env.GROK_CLI_CHAT_PROXY_BASE_URL": "pass",
        "setup/env.GROK_CONVERSATIONS_BASE_URL": "pass",
        "setup/env.GROK_FEEDBACK_BASE_URL": "pass",
        "setup/env.GROK_MANAGED_CONFIG_URL": "pass",
        "setup/env.GROK_MODELS_BASE_URL": "pass",
        "setup/env.GROK_TRACE_UPLOAD_URL": "pass",
        "setup/env.GROK_XAI_API_BASE_URL": "pass",
        "setup/env.XAI_API_KEY": "pass",
        "setup/hooks.install": "pass",
        "setup/instructions.written../AGENTS.md": "pass",
        "setup/instructions.written.~/.grok/AGENTS.md": "pass",
        "setup/skills": "pass"
      }
    }
  ]
}
